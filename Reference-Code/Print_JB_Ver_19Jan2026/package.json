{
  "name": "print-jb-standalone",
  "version": "0.1.0",
  "private": true,
  "devDependencies": {
    "tailwindcss": "^3.4.18",
    "esbuild": "^0.17.0"
  },
  "scripts": {
    "build:tailwind": "npx tailwindcss -i ./tailwind-input.css -o ./dist/css/tailwind.css --minify",
    "build:js": "npx esbuild js/main.js --bundle --outfile=dist/js/app.js --format=iife --minify",
    "build": "npm run build:tailwind && npm run build:js"
  }
}
